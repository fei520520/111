{
  "name": "warnfirst",
  "version": "1.1.0-test.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:place": "npm run build && node --test dist/agent/place-memory.test.js dist/agent/place-candidates.test.js dist/agent/scene-agent.test.js",
    "test:hazard": "npm run build && node --test dist/agent/hazard-watch.test.js dist/agent/response-arbiter.test.js dist/agent/hazard-check.test.js dist/agent/hazard-replay.test.js",
    "sim:hazard:replay": "npm run build && node dist/sim/hazard-replay.js",
    "sim:arbiter": "npm run build && node dist/sim/arbiter-compare.js",
    "sim:arbiter:sweep": "npm run build && node dist/sim/arbiter-sweep.js",
    "build": "tsc --noEmit false --outDir dist",
    "harness:sample": "npm run build && node --use-env-proxy dist/run-sample.js",
    "harness:cases": "npm run build && node --use-env-proxy dist/run-cases.js",
    "harness:feedback": "npm run build && node dist/record-feedback.js",
    "harness:summary": "npm run build && node dist/summarize.js",
    "trial:web": "npm run build && node --use-env-proxy dist/trial-server.js",
    "trial:qr": "npm run build && node --use-env-proxy dist/start-mobile-trial.js",
    "motion:replay": "npm run build && node dist/motion-replay.js",
    "motion:plot": "npm run build && node dist/plot-trajectory.js",
    "vio:plot": "npm run build && node dist/plot-vio.js",
    "motion:import": "npm run build && node dist/import-local-recording.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "cloudflared": "^0.7.3",
    "qrcode": "^1.5.4",
    "typescript": "5.9.3"
  }
}
